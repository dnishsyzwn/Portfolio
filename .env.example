# ==============================================================================
# SMTP Configuration for Portfolio Contact Form
# ==============================================================================
# Copy this file to .env.local and fill in your actual credentials.
#
# For Gmail:
# 1. Enable 2-Step Verification in your Google Account (https://myaccount.google.com/security).
# 2. Generate an "App Password" (search "App passwords" in Google Account settings).
# 3. Paste the 16-character generated password into SMTP_PASS below (without spaces).
# ==============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Your Gmail address that authenticates the SMTP connection
SMTP_USER=rvg.peanut@gmail.com

# 16-character App Password generated from your Google Account
SMTP_PASS=your-16-char-app-password

# Destination where you receive the inquiries
CONTACT_RECEIVER_EMAIL=rvg.peanut@gmail.com

# ==============================================================================
# Site Metadata & SEO
# ==============================================================================
# Your live production domain for canonical URLs, sitemaps, and social shares
NEXT_PUBLIC_SITE_URL=https://danishsyazwan.vercel.app
